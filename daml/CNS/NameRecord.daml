module CNS.NameRecord where

import Daml.Script

data NameRecord = NameRecord
  { name        : Text
  , partyId     : Party
  , owner       : Party
  , registrar   : Party
  , ttlSeconds  : Int
  , registeredAt: Time
  , expiresAt   : Time
  } deriving (Eq, Show)

template NameRecordContract
  with
    record    : NameRecord
    authority : Party
  where
    signatory authority, record.owner
    observer  record.partyId

    ensure record.name /= "" && record.ttlSeconds > 0

    choice RenewName : ContractId NameRecordContract
      with renewalSeconds : Int
      controller record.owner
      do
        now <- getTime
        create this with record = record
          { ttlSeconds = record.ttlSeconds + renewalSeconds
          , expiresAt  = addRelTime record.expiresAt (convertMicrosecondsToRelTime (intToMicro renewalSeconds * 1_000_000))
          }

    choice ArchiveRecord : ()
      controller authority
      do return ()

intToMicro : Int -> Int
intToMicro n = n
